# Local configuration for chora-duel-atom-smith.
# Copy to .env and fill in values. Never commit .env or secrets.

CHORA_ENV=local

# Model gateway (chora-model-gateway gRPC). The crew routes every LLM turn
# through this one chokepoint.
CHORA_GATEWAY_ENDPOINT=host.docker.internal:9090
# Static bearer token for authenticated gateway calls. The local model
# gateway does not enforce token auth; deployments fronting it with an
# authenticating proxy read the token from the environment.
CHORA_GATEWAY_TOKEN=
# Audience the gateway token was minted for (informational on the
# cloud-neutral path).
CHORA_GATEWAY_AUDIENCE=https://gateway.chora.site
# Plaintext gRPC to a local gateway (DEV ONLY — never in prod).
CHORA_GATEWAY_INSECURE=1

# Process fallback tenant identity. Per-request values come from session
# state (tenant_id / user_gcid) populated by the caller at
# async_create_session; these are the fallback when a request carries none.
CHORA_GATEWAY_TENANT_ID=
CHORA_GATEWAY_GCID=

# Model selection (AGENT-DRIVEN tiering). Override the smith primary model
# declared in internal/agentconfig/duel_atom_smith.yaml.
DUEL_ATOM_SMITH_MODEL=
# ADK session app name (every session.Create + StreamQuery carries it).
DUEL_ATOM_SMITH_SESSION_APP_NAME=chora-duel-atom-smith

# Traces — standard OTLP/gRPC. Unset streams spans to stdout in local dev.
OTEL_EXPORTER_OTLP_ENDPOINT=
CHORA_SERVICE_VERSION=dev
